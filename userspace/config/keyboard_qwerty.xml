<?xml version="1.0" encoding="UTF-8"?>
<keyboard3 xmlns="https://schemas.unicode.org/cldr/45/keyboard3" conformsTo="45" locale="en-US-t-k0-qwerty">
  <info name="US QWERTY"/>
  <keys>
    <key id="grave" output="`"/>
    <key id="one" output="1"/>
    <key id="two" output="2"/>
    <key id="three" output="3"/>
    <key id="four" output="4"/>
    <key id="five" output="5"/>
    <key id="six" output="6"/>
    <key id="seven" output="7"/>
    <key id="eight" output="8"/>
    <key id="nine" output="9"/>
    <key id="zero" output="0"/>
    <key id="minus" output="-"/>
    <key id="equal" output="="/>
    <key id="tilde" output="~"/>
    <key id="exclamation" output="!"/>
    <key id="at" output="@"/>
    <key id="hash" output="#"/>
    <key id="dollar" output="$"/>
    <key id="percent" output="%"/>
    <key id="caret" output="^"/>
    <key id="ampersand" output="&amp;"/>
    <key id="asterisk" output="*"/>
    <key id="left_parenthesis" output="("/>
    <key id="right_parenthesis" output=")"/>
    <key id="underscore" output="_"/>
    <key id="plus" output="+"/>
    <key id="q" output="q"/><key id="w" output="w"/><key id="e" output="e"/>
    <key id="r" output="r"/><key id="t" output="t"/><key id="y" output="y"/>
